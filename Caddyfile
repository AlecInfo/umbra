# TLS is terminated at Cloudflare's edge and the tunnel delivers plain HTTP to
# this container, so every site is bound to http:// explicitly.
#
# A bare hostname here would not do that: Caddy reads an address with no scheme
# and no port as HTTPS and binds it to 443. `auto_https off` only stops the
# certificate management and the HTTP-to-HTTPS redirect — it does not move the
# listener. Caddy then sits on 443 while cloudflared knocks on 80, and the
# tunnel reports the origin as refusing connections.
{
    auto_https off
    servers {
        protocols h1
        # cloudflared reaches us from the Docker network. Without this line Caddy
        # treats it as an untrusted client and REPLACES X-Forwarded-For with
        # cloudflared's own address, so the API saw 172.18.0.7 for every visitor
        # on Earth: one shared bucket for the login throttle, and a login log
        # that recorded the tunnel instead of the person (found 2026-10-27, the
        # API-side fix b236af2 never took effect behind the tunnel). Trusted,
        # Caddy appends its hop to the chain Cloudflare started, and the API —
        # which trusts the same private ranges — walks back to the visitor.
        trusted_proxies static private_ranges
    }
}

http://{$HS_HOST} {
    reverse_proxy headscale:8080 {
        header_up Connection Upgrade
        header_up Upgrade {http.request.header.Upgrade}
        flush_interval -1
    }
}

http://{$API_HOST} {
    reverse_proxy api:3333
}

http://{$WEB_HOST} {
    reverse_proxy web:3000
}
