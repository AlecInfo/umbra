{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UMBRA",
  "version": "0.1.0",
  "identifier": "io.umbravpn.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter web dev:app",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter web build:app",
    "frontendDist": "../../web/.output/public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "UMBRA",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Self-hosted VPN client",
    "longDescription": "Connect to the exit nodes of your UMBRA instance."
  }
}
