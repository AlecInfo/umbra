{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch bin/server.ts",
    "build": "node --import=tsx ace.js build",
    "start": "node bin/server.js",
    "test": "node --import=tsx bin/test.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "ace": "node --import=tsx ace.js",
    "migration:run": "node --import=tsx ace.js migration:run",
    "migration:rollback": "node --import=tsx ace.js migration:rollback",
    "migration:fresh": "node --import=tsx ace.js migration:fresh",
    "seed": "node --import=tsx ace.js db:seed"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.3.1",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/hash": "^10.1.0",
    "@adonisjs/limiter": "^3.0.1",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/mail": "^10.2.0",
    "@vinejs/vine": "^4.3.1",
    "luxon": "^3.5.0",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2"
  },
  "imports": {
    "#start/*": "./start/*.ts",
    "#app/*": "./app/*.ts",
    "#config/*": "./config/*.ts",
    "#database/*": "./database/*.ts",
    "#models/*": "./app/models/*.ts",
    "#controllers/*": "./app/controllers/*.ts",
    "#middleware/*": "./app/middleware/*.ts",
    "#services/*": "./app/services/*.ts",
    "#validators/*": "./app/validators/*.ts",
    "#exceptions/*": "./app/exceptions/*.ts",
    "#tests/*": "./tests/*.ts"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/tsconfig": "^1.4.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/luxon": "^3.4.2",
    "@types/node": "^25.6.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "youch": "^4.1.1"
  }
}
