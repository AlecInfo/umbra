# Loaded on top of .env when NODE_ENV=test (set by bin/test.ts).
#
# The suite TRUNCATEs every table between tests, so it must never run against
# the database you develop on. It used to: `pnpm test` silently wiped the dev
# data, node records and agent tokens included, which de-registers every
# enrolled machine.
#
# The database is created and migrated automatically by the test bootstrap.
DB_DATABASE=umbra_test

# Blank on purpose: with a key inherited from .env, headscaleClient.isConfigured
# is true and the suite talks to the real control plane — every test that
# enrolls a node created a tenant there, leaving dozens of orphan users behind.
# Tests that need Headscale stub the client instead (see connection_traffic).
HEADSCALE_API_KEY=