NODE_ENV=production
PORT=3333
HOST=0.0.0.0

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_KEY=change-me-32-chars-minimum

LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_USER=umbra
DB_PASSWORD=umbra
DB_DATABASE=umbra

# ── Headscale ────────────────────────────────────────────────────────────────
# Public URL that agents use to join the mesh (must be reachable from all nodes)
HEADSCALE_EXTERNAL_URL=http://localhost:8080
HEADSCALE_API_KEY=

# ── Public URLs (set when server is publicly accessible) ─────────────────────
# Used by the web container to call the API from the browser
API_PUBLIC_URL=http://localhost:3333/api/v1

# ── Cloudflare Tunnel (optional — for public access without port forwarding) ──
# Get token at: https://one.dash.cloudflare.com → Networks → Tunnels
# Configure routes in the dashboard:
#   umbra.example.com           → http://umbra-web:3000
#   api.umbra.example.com       → http://umbra-api:3333
#   headscale.umbra.example.com → http://umbra-headscale:8080
# Then set HEADSCALE_EXTERNAL_URL and API_PUBLIC_URL to those hostnames above.
CLOUDFLARE_TUNNEL_TOKEN=
