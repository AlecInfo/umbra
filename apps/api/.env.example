NODE_ENV=production
PORT=3333
HOST=0.0.0.0

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_KEY=change-me-32-chars-minimum

LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_USER=umbra
DB_PASSWORD=umbra
DB_DATABASE=umbra

# ── Headscale ────────────────────────────────────────────────────────────────
# Public URL that agents use to join the mesh (must be reachable from all nodes)
HEADSCALE_EXTERNAL_URL=http://localhost:8080
HEADSCALE_API_KEY=

# Native TLS mode — RECOMMENDED for any deployment serving clients behind
# CGNAT (mobile data, most home ISPs). Headscale terminates TLS on 443 itself
# and relays through its embedded DERP; NOTHING may sit in front of it.
# When set, deploy.sh adds docker-compose.tls.yml automatically.
#
#   HEADSCALE_TLS_HOSTNAME=hs.example.com
#   HEADSCALE_EXTERNAL_URL=https://hs.example.com
#
# Requires: 443/tcp + 3478/udp forwarded to this host, and a DNS A record
# resolving DIRECTLY to it — on Cloudflare, DNS-only (grey cloud). Proxying it
# (orange cloud) breaks both the DERP relay and the ACME challenge.
# See DEPLOYMENT.md for the alternative (proxy + standalone derper).
HEADSCALE_TLS_HOSTNAME=

# ── Public URLs (set when server is publicly accessible) ─────────────────────
# Used by the web container to call the API from the browser
API_PUBLIC_URL=http://localhost:3333/api/v1

# ── Cloudflare Tunnel (optional — for public access without port forwarding) ──
# Get token at: https://one.dash.cloudflare.com → Networks → Tunnels
# Route web + API through it:
#   umbra.example.com     → the tunnel
#   api.umbra.example.com → the tunnel
#
# NEVER route Headscale through the tunnel. A tunnel (like any reverse proxy)
# cannot carry the DERP relay channel — clients behind CGNAT then fail with
# "Relay server unavailable". Serve Headscale directly with
# HEADSCALE_TLS_HOSTNAME above, or run a standalone derper (--profile derp).
# deploy.sh refuses the broken combination.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Standalone DERP relay (alternative to native TLS mode) ───────────────────
# Only needed when Headscale sits behind a proxy/tunnel. Must resolve directly
# to a host with a public IP, 80+443/tcp and 3478/udp open.
#   DERP_HOSTNAME=derp.example.com
#   DERP_RUN_LOCAL=1   # only if THIS host is the public one
DERP_HOSTNAME=
