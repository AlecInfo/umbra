node_modules
.nuxt
.output
dist
.env

# Generated by deploy.sh — contains Cloudflare tunnel credentials
cloudflared/creds.json
cloudflared/config.yaml

# Local escape hatch, auto-loaded by docker compose. The TLS topology is no
# longer configured this way — it lives in the committed docker-compose.tls.yml
# (see DEPLOYMENT.md), so an override here now shadows it. Use with care.
docker-compose.override.yml

# Migration output: database dumps and the headscale volume, which holds the
# control plane's private keys, the TLS certificate key and pre-auth keys in
# clear. One of these reached a public repository because the export directory
# had been created under a slightly different name than the one ignored here,
# and `git add -A` swept it in. Match on content, not on a directory name.
*.sql
*.tgz
umbra-backup/
umbra-*/
